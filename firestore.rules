rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function normalizedEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedIn() && (
        normalizedEmail() == 'nccrvce2025@gmail.com' ||
        normalizedEmail() == 'nccrvceshaurya@gmail.com' ||
        normalizedEmail() == 'lokakshas.cs24@rvce.edu.in' ||
        normalizedEmail() == 'shaurya.lakshya.admin@gmail.com' ||
        normalizedEmail() == 'rvcecdtlokakshasridhar@gmail.com'
      );
    }

    match /artifacts/{appId}/public/data/registrations/{registrationId} {
      allow read: if signedIn() && (isAdmin() || registrationId == normalizedEmail());
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/slots/{slotId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/public/data/bookings/{bookingId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.participantEmail == normalizedEmail()
      );
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/leaderboard_entries/{entryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/audit_logs/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/public/data/app_config/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
