rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function normalizedEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedIn() && (
        normalizedEmail() == 'nccrvce2025@gmail.com' ||
        normalizedEmail() == 'nccrvceshaurya@gmail.com' ||
        normalizedEmail() == 'lokakshas.cs24@rvce.edu.in' ||
        normalizedEmail() == 'shaurya.lakshya.admin@gmail.com' ||
        normalizedEmail() == 'rvcecdtlokakshasridhar@gmail.com' ||
        normalizedEmail() == 'vaishnavkadam57@gmail.com' ||
        normalizedEmail() == 'vaishnavrkadam.cs25@rvce.edu.in' ||
        normalizedEmail() == 'rvcecdtvaishnav@gmail.com'
      );
    }

    function isRegistered(appId) {
      return signedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/registrations/$(normalizedEmail())) &&
          get(/databases/$(database)/documents/artifacts/$(appId)/public/data/registrations/$(normalizedEmail())).data.eligible != false
        )
      );
    }

    // Registrations collection (allowlist & intake roster)
    match /artifacts/{appId}/public/data/registrations/{registrationId} {
      allow read: if signedIn() && (
        isAdmin() || 
        resource == null ||
        registrationId.lower() == normalizedEmail() ||
        resource.data.email.lower() == normalizedEmail() ||
        resource.data.rvceEmail.lower() == normalizedEmail()
      );
      // Students can update their own gender division
      allow update: if signedIn() && (
        isAdmin() || 
        (registrationId.lower() == normalizedEmail() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gender', 'updatedAt']))
      );
      allow create, delete: if isAdmin();
    }

    // Slots collection (firing relays and capacities)
    match /artifacts/{appId}/public/data/slots/{slotId} {
      allow read: if true; // Publicly readable for schedule display
      // Registered eligible students can atomically reserve 1 slot seat within capacity; Admins have full management
      allow update: if signedIn() && (
        isAdmin() ||
        (
          isRegistered(appId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked', 'updatedAt']) &&
          request.resource.data.booked == resource.data.booked + 1 &&
          resource.data.booked < resource.data.capacity &&
          resource.data.isActive == true &&
          !slotId.matches('.*finals.*')
        )
      );
      allow create, delete: if isAdmin();
    }

    // Bookings collection (individual discipline tickets)
    match /artifacts/{appId}/public/data/bookings/{bookingId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource == null ||
        resource.data.participantEmail.lower() == normalizedEmail()
      );
      // Only registered eligible students can create their own self-service confirmed booking
      allow create: if signedIn() && (
        isAdmin() ||
        (
          isRegistered(appId) &&
          request.resource.data.participantEmail.lower() == normalizedEmail() &&
          request.resource.data.status == 'confirmed' &&
          request.resource.data.checkedIn == false &&
          request.resource.data.isDQ == false &&
          request.resource.data.totalScore == null &&
          !request.resource.data.slotId.matches('.*finals.*') &&
          bookingId == 'lakshya-2026_' + normalizedEmail() + '_' + request.resource.data.vertical
        )
      );
      // Only Admins / Range Safety Officers can update or delete bookings
      allow update, delete: if isAdmin();
    }

    // Leaderboard entries (public display and admin scoring)
    match /artifacts/{appId}/public/data/leaderboard_entries/{entryId} {
      allow read: if true; // Public display for live screens
      // Registered eligible students can initialize their 0-score booking entry; scoring is admin-only
      allow create: if signedIn() && (
        isAdmin() ||
        (
          isRegistered(appId) &&
          request.resource.data.bestScore == 0 &&
          request.resource.data.totalScore == 0 &&
          entryId == 'lakshya-2026_' + normalizedEmail() + '_' + request.resource.data.vertical
        )
      );
      allow update, delete: if isAdmin();
    }

    // Scorecards collection (round-by-round official target shots)
    match /artifacts/{appId}/public/data/scorecards/{scorecardId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Audit trail (immutable append-only)
    match /artifacts/{appId}/public/data/audit_logs/{auditId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Certificate requests collection (sapling photo upload & admin approvals)
    match /artifacts/{appId}/public/data/certificate_requests/{requestId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource == null ||
        resource.data.participantEmail.lower() == normalizedEmail() ||
        requestId.lower() == normalizedEmail()
      );
      allow create: if signedIn() && (
        isAdmin() ||
        (
          isRegistered(appId) &&
          request.resource.data.participantEmail.lower() == normalizedEmail() &&
          requestId.lower() == normalizedEmail() &&
          request.resource.data.status in ['Request Submitted', 'Under Review'] &&
          request.resource.data.checkedIn == true
        )
      );
      allow update: if signedIn() && (
        isAdmin() ||
        (
          resource.data.participantEmail.lower() == normalizedEmail() &&
          request.resource.data.participantEmail.lower() == normalizedEmail() &&
          request.resource.data.status in ['Request Submitted', 'Under Review']
        )
      );
      allow delete: if isAdmin();
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
